<?xml version="1.0" encoding="utf-8"?>
<!--
  Production build for 64-bit Linux:
    dotnet publish src/Sleipnir.App/Sleipnir.App.csproj -p:PublishProfile=linux-x64
  Produces a single self-contained executable (no .NET install needed) at artifacts/linux-x64/dnm.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Precompile to native code for faster start-up. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- No dependency on libicu: DNM doesn't need culture-specific text handling. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <PublishDir>artifacts/linux-x64/</PublishDir>
  </PropertyGroup>
</Project>
